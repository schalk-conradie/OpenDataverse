{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OpenDataverse",
  "version": "0.1.0",
  "identifier": "com.opendataverse.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run build:ai-sidecar && npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "OpenDataverse",
        "width": 1280,
        "height": 820,
        "minWidth": 1080,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../src-sidecar/ai/dist/": "src-sidecar/ai/dist/",
      "../src-sidecar/ai/node_modules/@openai/": "src-sidecar/ai/node_modules/@openai/"
    },
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJGMUQ2Q0M0RDlCNzYyRjgKUldUNFlyZlp4R3dkTDNEUE9XalU0aWFkVHFmNlQzZ1JPT2xUMXVJV0Nka29wTWZnYjZPVzRIbkgK",
      "endpoints": [
        "https://github.com/schalk-conradie/OpenDataverse/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
